#!/usr/bin/env bash
# Install FiraCode Nerd Font on the host (required for NvChad icons in dnvim)
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_FONTS="${REPO_ROOT}/home/Library/Fonts/FiraCode"
FONT_NAME="FiraCode Nerd Font"
NERD_FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/FiraCode.zip"

install_macos() {
  local dest="${HOME}/Library/Fonts/FiraCode"
  mkdir -p "${dest}"

  if [[ -d "${REPO_FONTS}" ]] && ls "${REPO_FONTS}"/*.ttf &>/dev/null; then
    cp "${REPO_FONTS}"/*.ttf "${dest}/"
    echo "Installed fonts from dotfiles to ${dest}"
  else
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "${tmp}/FiraCode.zip" "${NERD_FONT_URL}"
    unzip -q "${tmp}/FiraCode.zip" -d "${dest}"
    rm -rf "${tmp}"
    echo "Downloaded and installed fonts to ${dest}"
  fi

  echo ""
  echo "Next: set your terminal font to '${FONT_NAME}'"
  echo "  iTerm2:     Settings → Profiles → Text → Font"
  echo "  Terminal:   Settings → Profiles → Font"
  echo "  Cursor:     Settings → Terminal › Integrated: Font Family"
}

install_linux() {
  local dest="${HOME}/.local/share/fonts/FiraCode"
  mkdir -p "${dest}"

  if [[ -d "${REPO_FONTS}" ]] && ls "${REPO_FONTS}"/*.ttf &>/dev/null; then
    cp "${REPO_FONTS}"/*.ttf "${dest}/"
  else
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "${tmp}/FiraCode.zip" "${NERD_FONT_URL}"
    unzip -q "${tmp}/FiraCode.zip" -d "${dest}"
    rm -rf "${tmp}"
  fi

  command -v fc-cache &>/dev/null && fc-cache -fv "${dest}" >/dev/null 2>&1 || true

  echo "Installed fonts to ${dest}"
  echo "Set your terminal font to '${FONT_NAME}' in your terminal emulator's preferences."
}

case "$(uname -s)" in
  Darwin) install_macos ;;
  Linux) install_linux ;;
  *)
    echo "Run this on macOS or Linux, or install '${FONT_NAME}' manually on Windows."
    echo "Download: ${NERD_FONT_URL}"
    echo "Windows Terminal: Settings → Profiles → Appearance → Font face"
    exit 1
    ;;
esac
